# ==========================================
# AITrustScore — Environment Variables
# ==========================================

# Application
PROJECT_NAME="AITrustScore"
PROJECT_VERSION="1.0.0"

# Security (Generate a secure secret key for production)
SECRET_KEY="aitrustscore-vit-chennai-tamohar-das-2026-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default: Local SQLite for zero-config instant local setup & viva demo
DATABASE_URL="sqlite:///./aitrustscore.db"
# PostgreSQL Docker format:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aitrustscore"

# Demonstration Mode (enables deterministic benchmark claims for viva presentation)
DEMO_MODE=True

# External API Integrations (Optional)
# Enter Google Fact Check Tools API Key to query live fact-check registries
GOOGLE_FACTCHECK_API_KEY=""
